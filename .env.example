# ── Server-side (Vercel project settings → Environment Variables) ────────────
# Powers POST /api/coach so every user gets live Claude with no client-side key.
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-haiku-4-5

# Server-side mirror of the Supabase vars (used by /api/admin/* to verify JWTs).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-ONLY secret — enables the admin users directory (/api/admin/users).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Build-time (baked into the bundle; redeploy after changing) ──────────────
# When both are set, auth + database run on Supabase (email/password + Google OAuth).
# When unset, the app runs local-first with zero configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Real client-side Google sign-in (Google Identity Services).
# Google Cloud Console → Credentials → OAuth client ID (Web) →
# Authorized JavaScript origins: https://<your-app>.vercel.app
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
